---
import { APP_DEFAULT_LANGUAGE } from '@/constants/appLanguages'

interface Props {
  title: string
  description?: string
  image?: string
  noindex?: boolean
}

const { title, description, image, noindex = false } = Astro.props
const lang = Astro.currentLocale ?? APP_DEFAULT_LANGUAGE
const origin = Astro.site ?? Astro.url
const canonicalUrl = new URL(Astro.url.pathname, origin).href
const hasDescription = description !== undefined
const imageUrl = image === undefined ? null : new URL(image, origin).href
const hasImage = imageUrl !== null
---

<html lang={lang}>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>{title} · %%APP_NAME_HTML%%</title>
    {hasDescription ? <meta name='description' content={description} /> : null}
    {noindex ? <meta name='robots' content='noindex' /> : <link rel='canonical' href={canonicalUrl} />}
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='%%APP_NAME_HTML%%' />
    <meta property='og:title' content={title} />
    {hasDescription ? <meta property='og:description' content={description} /> : null}
    {hasImage ? <meta property='og:image' content={imageUrl} /> : null}
    <meta name='twitter:card' content={hasImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <slot />
  </body>
</html>
